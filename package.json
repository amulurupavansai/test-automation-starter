{
  "name": "test-automation-starter",
  "version": "1.0.0",
  "description": "Reusable Playwright + TypeScript web test-automation starter with a bundled demo app",
  "private": true,
  "scripts": {
    "demo": "node demo-app/server.js",
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:staging": "TEST_ENV=staging playwright test",
    "test:dev": "TEST_ENV=dev playwright test",
    "snapshots:update": "playwright test tests/visual.spec.ts --update-snapshots",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "playwright-core": "1.63.0"
  }
}
