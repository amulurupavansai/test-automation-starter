# Copy to .env and adjust. Never commit real secrets or real credentials.
# Which environment to run against: local | dev | staging
TEST_ENV=local

# Base URLs per environment (placeholders - replace with your own)
LOCAL_BASE_URL=http://localhost:4173
DEV_BASE_URL=https://dev.app.example.test
STAGING_BASE_URL=https://staging.app.example.test

# Test-account credentials for the selected environment.
# The values below are the FAKE credentials of the bundled demo app.
TEST_USER_EMAIL=qa.user@example.test
TEST_USER_PASSWORD=Passw0rd!demo

# Optional: path to an existing Chrome/Chromium binary (skips `npx playwright install`)
# CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
